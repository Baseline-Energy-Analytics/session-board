#!/usr/bin/env python3
"""cs: pick a Claude Code session from a numbered menu and open it.

Lists the sessions you started (not plugin or headless automation) from the last 30 days,
across every folder: needs you first, then running, parked, then ended by recency.
Picking a number resumes an ended session in its own folder (`claude --resume <id>`) or
reattaches a background one (`claude attach <job>`). Sessions open in another terminal are
shown but not reopened, since that would start a second process on the same conversation.

  cs              menu
  cs <text>       menu filtered by title or folder
  cs --list       print the list and exit
  cs --dry-run N  print what choosing N would run
Meant as a Termius host Startup Command: connect, type a number, Enter.
"""
import glob, json, os, shutil, subprocess, sys, time

HOME = os.path.expanduser("~")
CLAUDE = os.path.join(HOME, ".claude")
DAYS, LIMIT = 30, 15
RANK = {"needs you": 0, "running": 1, "parked": 2, "elsewhere": 1, "ended": 3}
GLYPH = {"needs you": "◆", "running": "●", "parked": "■", "elsewhere": "●", "ended": "○"}
COLOR = {"needs you": "33;1", "running": "32", "parked": "34", "elsewhere": "32", "ended": "2"}


def jsonl(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                yield json.loads(line)
            except ValueError:
                continue


def iso_ms(v):
    from datetime import datetime
    try:
        return int(datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp() * 1000)
    except (AttributeError, ValueError):
        return 0


def transcripts():
    cutoff = time.time() - DAYS * 86400
    for path in glob.glob(os.path.join(CLAUDE, "projects", "*", "*.jsonl")):
        if os.path.getmtime(path) < cutoff:
            continue
        s = {"id": os.path.basename(path)[:-6], "cwd": None, "last": 0, "entry": None, "typed": 0,
             "ai": None, "custom": None, "first": None}
        for e in jsonl(path):
            t = e.get("type")
            if t == "ai-title": s["ai"] = e.get("aiTitle")
            elif t == "custom-title": s["custom"] = e.get("customTitle")
            elif t in ("user", "assistant"):
                s["cwd"] = s["cwd"] or e.get("cwd")
                s["entry"] = s["entry"] or e.get("entrypoint")
                s["last"] = max(s["last"], iso_ms(e.get("timestamp")))
                if t == "user" and e.get("promptSource") in ("typed", "queued") and not e.get("isSidechain"):
                    c = (e.get("message") or {}).get("content")
                    text = c if isinstance(c, str) else " ".join(p.get("text", "") for p in c or [] if isinstance(p, dict))
                    if text.strip() and not text.strip().startswith("/"):
                        s["typed"] += 1
                        s["first"] = s["first"] or text.strip().splitlines()[0][:80]
        yield s


def live():
    """Running processes from ~/.claude/sessions, kept only if pid and start time still match."""
    out = {}
    for path in glob.glob(os.path.join(CLAUDE, "sessions", "*.json")):
        try:
            r = json.load(open(path))
            with open(f"/proc/{r['pid']}/stat") as f:
                if f.read().rsplit(")", 1)[1].split()[19] != str(r.get("procStart")):
                    continue
        except (OSError, ValueError, KeyError, IndexError):
            continue
        out[r["sessionId"]] = r
    return out


def jobs():
    out = {}
    for path in glob.glob(os.path.join(CLAUDE, "jobs", "*", "state.json")):
        try:
            st = json.load(open(path))
        except (OSError, ValueError):
            continue
        out[st.get("sessionId")] = dict(st, job=os.path.basename(os.path.dirname(path)))
    return out


def sessions(query=None):
    lv, jb, rows = live(), jobs(), []
    for s in transcripts():
        job = jb.get(s["id"])
        if not job and (s["entry"] != "cli" or not s["typed"]):
            continue  # automation, or opened and closed without a prompt
        proc = lv.get(s["id"])
        if job:
            tempo = job.get("tempo")
            state = "needs you" if tempo == "blocked" or job.get("state") == "needs_input" else \
                    "running" if tempo == "active" else "parked"
        elif proc and proc.get("kind") == "interactive":
            state = "elsewhere"
        else:
            state = "ended"
        title = (job or {}).get("name") or s["custom"] or s["ai"] or s["first"] or "(untitled)"
        folder = (s["cwd"] or "?").replace(HOME, "~")
        if query and query.lower() not in (title + " " + folder).lower():
            continue
        rows.append({**s, "state": state, "title": title, "folder": folder, "job": (job or {}).get("job")})
    rows.sort(key=lambda r: (RANK[r["state"]], -r["last"]))
    return rows[:LIMIT]


def ago(ms):
    s = time.time() - ms / 1000
    return "now" if s < 90 else f"{int(s // 60)}m" if s < 3600 else f"{int(s // 3600)}h" if s < 86400 else f"{int(s // 86400)}d"


def paint(code, text, tty):
    return f"\033[{code}m{text}\033[0m" if tty else text


def show(rows):
    tty = sys.stdout.isatty()
    width = shutil.get_terminal_size((80, 24)).columns
    label = {"elsewhere": "open in another terminal"}
    print(paint("1", f"Claude sessions on {os.uname().nodename}", tty))
    for n, r in enumerate(rows, 1):
        g, st = paint(COLOR[r["state"]], GLYPH[r["state"]], tty), label.get(r["state"], r["state"])
        if width >= 78:
            short = "open elsewhere" if r["state"] == "elsewhere" else st
            detail = "%-14s %4s  %s" % (short, ago(r["last"]), r["folder"])
            print(" %2d %s %-40s %s" % (n, g, r["title"][:40], paint("2", detail, tty)))
        else:  # phone width: title on one line, details under it
            print(f" {n:>2} {g} {r['title'][:width - 7]}")
            print(paint("2", f"      {st}, {ago(r['last'])}, {r['folder']}"[:width], tty))
    print(paint("2", "  n new session   q shell", tty))


def command(r):
    if r["job"]:
        return ["claude", "attach", r["job"]], HOME
    return ["claude", "--resume", r["id"]], os.path.expanduser(r["folder"]) if r["folder"] != "?" else HOME


def main(argv):
    dry = "--dry-run" in argv
    args = [a for a in argv if a not in ("--dry-run", "--list")]
    pick = args.pop() if dry and args and args[-1].isdigit() else None
    rows = sessions(" ".join(args) or None)
    if not rows:
        print("No sessions found. Start one with: claude")
        return 0
    show(rows)
    if "--list" in argv:
        return 0
    choice = pick or input("> ").strip().lower()
    if choice in ("", "q"):
        return 0
    if choice == "n":
        where = input("folder [~]: ").strip() or "~"
        cmd, cwd = ["claude"], os.path.expanduser(where)
    elif choice.isdigit() and 1 <= int(choice) <= len(rows):
        r = rows[int(choice) - 1]
        if r["state"] == "elsewhere":
            print("That session is open in another terminal. Close it there, or press ← there to move it to the background.")
            return 1
        cmd, cwd = command(r)
    else:
        print("Pick a number from the list, n, or q.")
        return 1
    if dry:
        print(f"would run: cd {cwd} && {' '.join(cmd)}")
        return 0
    return subprocess.call(cmd, cwd=cwd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (KeyboardInterrupt, EOFError):
        print()
        sys.exit(130)
